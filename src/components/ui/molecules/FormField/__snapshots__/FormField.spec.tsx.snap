exports[`FormField > renders a textarea and preserves description associations when invalid 1`] = `
<DocumentFragment>
  <div
    class="_field_08bc51"
  >
    <label
      class="typography-body1 font-bold text-ink"
      for="question"
    >
      Your question
    </label>
    <textarea
      aria-describedby="question-help question-error"
      aria-invalid="true"
      class="typography-body1 _control_08bc51 _textarea_08bc51 custom-control"
      id="question"
      rows="4"
    />
