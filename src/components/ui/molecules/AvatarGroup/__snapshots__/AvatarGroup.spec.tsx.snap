exports[`AvatarGroup > renders custom avatars and native props 1`] = `
<DocumentFragment>
  <div
    aria-label="Featured learner portraits"
    class="inline-flex shrink-0 items-center -space-x-2 [&>img:nth-child(2)]:relative [&>img:nth-child(2)]:z-10 mt-4"
    id="featured-learners"
    role="group"
  >
    <img
      alt="Featured learner"
      class="box-border h-8 w-8 shrink-0 rounded-full border border-surface object-cover"
      data-nimg="1"
      decoding="async"
      height="32"
      loading="lazy"
      src="/images/learners/learner-2.jpg"
      style="color: transparent;"
      width="32"
    />
  </div>
</DocumentFragment>
`;

